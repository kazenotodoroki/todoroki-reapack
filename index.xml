  <category name="FX">
    <reapack name="RefLab.jsfx" type="effect" desc="RefLab - Referencing multi-pistes (spectre, LUFS, match loudness, boucles)">
      <metadata>
        <description><![CDATA[{\rtf1\ansi\deff0{\fonttbl{\f0 \fswiss Helvetica;}{\f1 \fmodern Courier;}}
{\colortbl;\red255\green0\blue0;\red0\green0\blue255;}
\widowctrl\hyphauto

{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel0 \b \fs36 RefLab\par}
{\pard \ql \f0 \sa180 \li0 \fi0 Comparaison mix / references dans REAPER, en JSFX (compatible REAPER portable).\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab 4 references, chargees depuis {\f1 <REAPER>/Data/references}\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Spectre mix + reference superposes, courbe d'ecart, vitesse de mesure reglable\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab LUFS momentary / short-term / integre (BS.1770), match loudness automatique\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Boucle par reference (glisser sur la forme d'onde)\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Tous les reglages assignables en MIDI (Param > Learn) ou via les actions "RefLab - ..."\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 A placer dans le Monitoring FX. Le paquet {\b Todoroki Companion} ajoute l'ouverture du dossier des references et la mise a jour automatique de la liste.\par}
}
]]></description>
      </metadata>
      <version name="1.2" author="Todoroki" time="2026-10-20T16:29:59Z">
        <changelog><![CDATA[- Vitesse de mesure du spectre reglable : rapide, moyen, lent, tres lent, moyenne infinie
- Bouton VITESSE, clic droit / touche R : remise a zero de la moyenne
- Deux nouveaux parametres assignables : vitesse suivante, reset moyenne spectre
- Fonctionne avec le Todoroki Companion (dossier references, actualisation)]]></changelog>
        <source>https://github.com/kazenotodoroki/todoroki-reapack/raw/1c6331afc4eea14bc64748bc6c201c857f395690/FX/RefLab.jsfx</source>
      </version>
    </reapack>
